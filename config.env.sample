# ==========================================
#      ⚡𝗛𝗘𝗠𝗔𝗡𝗧𝗛⚡ / ⚡𝗛𝗘𝗠𝗔𝗡𝗧𝗛⚡ CONFIG TEMPLATE
# ==========================================

# ----- REQUIRED CONFIG -----
BOT_TOKEN = ""                           # Get this from @BotFather
OWNER_ID = ""                            # Your Telegram User ID
TELEGRAM_API = ""                       # Get this from https://my.telegram.org
TELEGRAM_HASH = ""                      # Get this from https://my.telegram.org
DATABASE_URL = ""                       # MongoDB Atlas URI (Mandatory for settings persistence)

# ----- OPTIONAL CORE CONFIG -----
GDRIVE_ID = ""                          # Folder ID where you want to upload Mirror files
IS_TEAM_DRIVE = "False"                 # Set to True if GDRIVE_ID is a Team Drive
INDEX_URL = ""                          # Your Index Link for GDrive
AUTHOR_NAME = "⚡𝗛𝗘𝗠𝗔𝗡𝗧𝗛⚡"                 # Branding name for the bot
AUTHOR_URL = "https://t.me/yourchannel" # Branding link
TIMEZONE = "Asia/Kolkata"               # Your Timezone (e.g., UTC, Asia/Kolkata)
CMD_SUFFIX = ""                         # Add a suffix to all commands (e.g., _hem)
AUTHORIZED_CHATS = ""                   # IDs of Chats/Groups where the bot can be used
SUDO_USERS = ""                         # IDs of users who can use all commands
DEFAULT_UPLOAD = "gd"                   # 'gd' for GDrive, 'rc' for RClone, 'tg' for Telegram
DEFAULT_LANG = "en"                     # Bot language

# ----- ADVANCED VIDEO TOOLS (-vt) -----
EE_VIDEO_TOOL = "True"                  # Enable Enhanced Video Tools
AUTO_MERGE = "False"                    # Automatically merge files after download
FFMPEG_CMDS = "{}"                      # Custom FFMPEG commands in JSON format
WATERMARK_PATH = ""                     # Path to watermark image or GDrive ID
THUMBNAIL_LAYOUT = "2x2"                # Screenshot layout (e.g., 2x2, 3x3)
LEECH_SPLIT_SIZE = "2097152000"         # Max split size for Telegram (default 2GB)

# ----- STORAGE & INTEGRATION -----
TOKEN_PICKLE = ""                       # Base64 encoded token.pickle for GDrive
RCLONE_CONFIG = ""                      # Base64 encoded rclone.conf content
RCLONE_PATH = ""                        # Default RClone cloud path
RCLONE_FLAGS = "--fast-list"            # Default flags for RClone
USE_SERVICE_ACCOUNTS = "False"          # Set to True if using GDrive SAs

# ----- UI & STATUS BAR -----
STATUS_LIMIT = "10"                     # Max number of tasks shown in one status message
STATUS_UPDATE_INTERVAL = "15"           # Interval in seconds to update status
SEARCH_API_LINK = ""                    # Torrent search API link
SEARCH_LIMIT = "0"                      # Max search results

# ----- LEECH SETTINGS -----
AS_DOCUMENT = "False"                   # Default upload mode for Leech
LEECH_FILENAME_PREFIX = ""              # Prefix for leeched files
LEECH_CAPTION = "<b>{filename}</b>"     # Custom caption for Telegram uploads
MEDIA_GROUP = "False"                   # Upload multiple files as a media group
HYBRID_LEECH = "True"                   # Enable Hybrid Leech mode

# ----- QUEUEING SYSTEM -----
QUEUE_ALL = "0"                         # Max concurrent tasks
QUEUE_DOWNLOAD = "0"                    # Max concurrent downloads
QUEUE_UPLOAD = "0"                      # Max concurrent uploads

# ----- UPSTREAM REPO (For Heroku/Docker auto-updates) -----
UPSTREAM_REPO = "https://github.com/HEMANTH/⚡𝗛𝗘𝗠𝗔𝗡𝗧𝗛⚡"
UPSTREAM_BRANCH = "wzv3"
UPDATE_PKGS = "True"                    # Update pip requirements on restart

# ----- DISABLE OPTIONS -----
DISABLE_TORRENTS = "False"
DISABLE_LEECH = "False"
DISABLE_BULK = "False"
DISABLE_MULTI = "False"
DISABLE_SEED = "False"
DISABLE_FF_MODE = "False"
